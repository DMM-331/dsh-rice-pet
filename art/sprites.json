    "wiggle":    { "frames": ["wiggle-1", "wiggle-2", "wiggle-3", "wiggle-4"], "ms": 120 },
    "tired":     { "frames": ["tired-1", "tired-2", "tired-3", "tired-2"], "ms": [600, 500, 700, 500] },

